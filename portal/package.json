{
  "name": "crimson-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts",
    "demo:snapshot": "python scripts/demo_snapshot.py",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:base": "playwright test capturas.spec.ts --update-snapshots",
    "e2e:servir": "vite build --config vite.e2e.config.ts && vite preview --config vite.e2e.config.ts",
    "e2e:tipos": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "4.1.12"
  }
}
